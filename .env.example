# Copy to .env and fill in only what you use. Never commit .env.

# Optional: Claude mode for "Chat with Data" (numbers always come from read-only DuckDB queries).
# Requires: pip install python-dotenv (anthropic is in requirements.txt)
ANTHROPIC_API_KEY=
VDL_LLM_MODEL=claude-sonnet-5-5

# Future CRM connectors (shown as "Not configured" until all vars are set)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8501/oauth/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
VDL_DB_URL=
